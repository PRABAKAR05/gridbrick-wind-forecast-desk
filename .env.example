# Copy to .env for local overrides. All values are optional.
# GRIDBRICK_DATABASE_URL=sqlite:///backend/data/gridbrick.db
# GRIDBRICK_SEED_DIR=backend/seeds
# GRIDBRICK_DEFAULT_CUTOFF_HOUR=9
# GRIDBRICK_DEFAULT_CUTOFF_MINUTE=30
# GRIDBRICK_BAND_LOOKBACK_DAYS=14
# GRIDBRICK_BAND_INFLATION=1.15
# GRIDBRICK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GRIDBRICK_ADMIN_TOKEN=change-me
